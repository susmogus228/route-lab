{
  "openapi": "3.1.0",
  "info": {
    "title": "RouteLab local API",
    "version": "0.1.1",
    "description": "No API key. Runs on loopback. Models and datasets are local; no paid external inference API."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Local service status",
        "responses": {
          "200": {
            "description": "Recorded or live response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/evidence": {
      "get": {
        "summary": "Available recorded evidence downloads",
        "responses": {
          "200": {
            "description": "Recorded or live response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/presets": {
      "get": {
        "summary": "Original editable synthetic scenarios",
        "responses": {
          "200": {
            "description": "Recorded or live response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/benchmark": {
      "get": {
        "summary": "Recorded benchmark summary",
        "responses": {
          "200": {
            "description": "Recorded or live response",
