                      ],
                      "minimum": 0
                    },
                    "expanded": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "heap_peak": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "runtime_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "trace": {
                      "type": "array",
                      "maxItems": 2048,
                      "items": {
                        "type": "object",
                        "required": [
                          "node",
                          "g",
                          "h",
                          "f"
                        ],
                        "properties": {
                          "node": {
                            "type": "array",
                            "minItems": 2,
