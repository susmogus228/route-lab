    "/api/threshold": {
      "post": {
        "summary": "Find the first cost where the cost-1 reference route loses optimality",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "grid",
                  "start",
                  "goal",
                  "cells"
                ],
                "properties": {
                  "grid": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 128,
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9
                      }
                    },
                    "description": "Rectangular; at most 256 total cells for analysis; 0=wall, 1..9=entry cost"
                  },
                  "start": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "goal": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "cells": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "description": "Traversable non-endpoint cells whose entry cost changes together"
                  }
                },
                "additionalProperties": false
              },
              "example": {
                "grid": [
                  [
                    1,
                    9,
                    9,
                    9,
                    1
                  ],
                  [
                    1,
                    1,
                    1,
                    1,
                    1
                  ]
                ],
                "start": [
                  0,
                  0
                ],
                "goal": [
                  0,
                  4
                ],
                "cells": [
                  [
                    0,
                    1
                  ],
                  [
                    0,
                    2
                  ],
                  [
                    0,
                    3
                  ]
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful calculation, including valid abstention or unreachable results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schema_version",
                    "cost_unit",
                    "cells",
                    "reference_path",
                    "first_switch_cost",
                    "levels"
                  ],
                  "properties": {
                    "schema_version": {
                      "const": 1
                    },
                    "cost_unit": {
                      "const": "abstract_entry_cost"
                    },
                    "cells": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "reference_path": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "first_switch_cost": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1,
                      "maximum": 9
                    },
                    "levels": {
                      "type": "array",
                      "minItems": 9,
                      "maxItems": 9,
                      "items": {
                        "type": "object",
                        "required": [
                          "entry_cost",
                          "reachable",
                          "cost",
                          "steps",
                          "path",
                          "reference_cost",
                          "reference_optimal"
                        ],
                        "properties": {
                          "entry_cost": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9
                          },
                          "reachable": {
                            "type": "boolean"
                          },
                          "cost": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "steps": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "path": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "minItems": 2,
                              "maxItems": 2,
                              "items": {
                                "type": "integer",
                                "minimum": 0
                              }
                            }
                          },
                          "reference_cost": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "reference_optimal": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "code"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Invalid host or cross-origin request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
