                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/compare": {
      "post": {
        "summary": "Compare optimal costs on the same map",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "grid",
                  "start",
                  "goal"
                ],
                "properties": {
                  "grid": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 128,
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9
                      }
                    },
                    "description": "Rectangular; 0=wall, 1..9=entry cost"
                  },
                  "start": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "goal": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "trace_limit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2048,
                    "default": 512
                  }
                },
                "additionalProperties": false
              },
              "example": {
                "grid": [
                  [
                    1,
                    9,
                    9,
                    9,
                    1
                  ],
                  [
                    1,
                    1,
                    1,
                    1,
                    1
                  ]
                ],
                "start": [
                  0,
                  0
                ],
                "goal": [
                  0,
                  4
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful calculation, including valid abstention or unreachable results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "results",
                    "costs_agree"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "object",
                        "required": [
                          "algorithm",
                          "reachable",
                          "cost",
                          "cost_unit",
                          "path",
                          "steps",
                          "expanded",
                          "heap_peak",
                          "runtime_ms",
                          "trace",
                          "trace_truncated"
                        ],
                        "properties": {
                          "algorithm": {
                            "type": "string",
                            "enum": [
                              "astar",
                              "dijkstra"
                            ]
                          },
                          "reachable": {
                            "type": "boolean"
                          },
                          "cost": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "cost_unit": {
                            "const": "abstract_entry_cost"
                          },
                          "path": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "minItems": 2,
                              "maxItems": 2,
                              "items": {
                                "type": "integer",
                                "minimum": 0
                              }
                            }
                          },
                          "steps": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "expanded": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "heap_peak": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "runtime_ms": {
                            "type": "number",
                            "minimum": 0
                          },
                          "trace": {
                            "type": "array",
                            "maxItems": 2048,
                            "items": {
                              "type": "object",
                              "required": [
                                "node",
                                "g",
                                "h",
                                "f"
                              ],
                              "properties": {
                                "node": {
                                  "type": "array",
                                  "minItems": 2,
                                  "maxItems": 2,
                                  "items": {
                                    "type": "integer",
                                    "minimum": 0
                                  }
                                },
                                "g": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "h": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "f": {
                                  "type": "number",
                                  "minimum": 0
                                }
                              }
                            }
                          },
                          "trace_truncated": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "costs_agree": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "code"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Invalid host or cross-origin request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "code"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 256 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "code"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "code"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Calculation failure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "code"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/solve": {
      "post": {
        "summary": "Solve a weighted map",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "grid",
                  "start",
                  "goal"
                ],
                "properties": {
                  "grid": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 128,
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9
                      }
                    },
                    "description": "Rectangular; 0=wall, 1..9=entry cost"
                  },
                  "start": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "goal": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "trace_limit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2048,
                    "default": 512
                  },
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "astar",
                      "dijkstra"
                    ],
                    "default": "astar"
                  }
                },
                "additionalProperties": false
              },
              "example": {
                "grid": [
                  [
                    1,
                    9,
                    9,
                    9,
                    1
                  ],
                  [
                    1,
                    1,
                    1,
                    1,
                    1
                  ]
                ],
                "start": [
                  0,
                  0
                ],
                "goal": [
                  0,
                  4
                ],
                "algorithm": "astar"
              }
            }
          }
        },
