                  },
                  "goal": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "additionalProperties": false
              },
              "example": {
                "grid": [
                  [
                    1,
                    9,
                    9,
                    9,
                    1
