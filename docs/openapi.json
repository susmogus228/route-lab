    "/api/closures": {
      "post": {
        "summary": "Test every single-cell closure independently on a map up to 256 cells",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "grid",
                  "start",
                  "goal"
                ],
                "properties": {
                  "grid": {
                    "type": "array",
